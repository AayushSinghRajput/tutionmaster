{
  "name": "tutionmaster-backend",
  "version": "1.0.0",
  "description": "Backend for TutionMaster tutoring platform",
  "main": "server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "start:prod": "pm2 start ecosystem.config.js",
    "stop:prod": "pm2 stop ecosystem.config.js",
    "restart:prod": "pm2 restart ecosystem.config.js",
    "logs:prod": "pm2 logs tutionmaster-backend",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@google/genai": "^2.17.1",
    "bcryptjs": "^2.4.0",
    "cloudinary": "^1.40.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.0",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "express-async-handler": "^1.2.0",
    "express-fileupload": "^1.5.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.6.1",
    "express-validator": "^7.0.0",
    "google-auth-library": "^11.0.2",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^7.0.0",
    "morgan": "^1.11.0",
    "multer": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "streamifier": "^0.1.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^2.0.0",
    "pm2": "^7.0.3",
    "supertest": "^7.2.2"
