# Copy this file to .env and fill in real values. Never commit .env.

# Server
NODE_ENV=development
PORT=8000

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/tutionmaster

# JWT auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=7d

# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:3000

# Cloudinary (avatar/CV storage)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Google Sign-In (optional — omitting disables /api/auth/google)
GOOGLE_CLIENT_ID=your-google-client-id

# Gemini AI assistant (optional — omitting disables /api/ai/chat, which then
# responds with a friendly "not configured" message instead of erroring).
# Get a free-tier key at https://aistudio.google.com/apikey — no billing
# required for development. Moving to a paid tier later is a config change
# only: swap the key and/or GEMINI_MODEL, no code changes needed.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TEMPERATURE=0.3
GEMINI_MAX_OUTPUT_TOKENS=1024

INDEXNOW_API_KEY=your-indexnow-api-key
INDEXNOW_HOST=www.tuitionmaster.guru
INDEXNOW_PROTOCOL=https

# ── Admin Panel ────────────────────────────────────────────
# Distinct JWT secret for admin tokens (different from JWT_SECRET)
ADMIN_JWT_SECRET=replace-with-a-different-long-random-secret
ADMIN_JWT_EXPIRE=7d

# The permanent Super Admin email — MUST match the seeded account
SUPER_ADMIN_EMAIL=SUPER_ADMIN_EMAIL_ADDRESS
SUPER_ADMIN_NAME=SUPER_ADMIN_USERNAME

# Password used by the seed script (only needed once during setup)
# ADMIN_PASSWORD=your-super-admin-password

# Production admin panel domain for CORS (leave blank in dev)
# ADMIN_PANEL_ORIGIN=https://admin.tuitionmaster.guru

# ── SMTP Email Service ────────────────────────────────────
# Configure your SMTP provider (e.g., Gmail App Password, Resend SMTP, SendGrid, Mailgun)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL="TuitionMaster Team" <noreply@tuitionmaster.guru>
FRONTEND_URL=http://localhost:3000
